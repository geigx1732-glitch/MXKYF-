-- ═══════════ 🔒 CLEANUP SYSTEM ═══════════
local CleanupRegistry = { connections={}, instances={}, loops={} }

local function registerConnection(conn) table.insert(CleanupRegistry.connections, conn); return conn end
local function registerInstance(inst) table.insert(CleanupRegistry.instances, inst); return inst end
local function registerLoop(thread) table.insert(CleanupRegistry.loops, thread); return thread end

_G.MZ_HUB_DESTROY = function()
    print("🔴 MZ HUB: กำลังปิดทุกฟังก์ชัน...")
    
    for _, conn in ipairs(CleanupRegistry.connections) do
        pcall(function() conn:Disconnect() end)
    end
    CleanupRegistry.connections = {}
    
    for _, inst in ipairs(CleanupRegistry.instances) do
        pcall(function() if inst then inst:Destroy() end end)
    end
    CleanupRegistry.instances = {}
    
    for _, thread in ipairs(CleanupRegistry.loops) do
        pcall(function() if thread then task.cancel(thread) end end)
    end
    CleanupRegistry.loops = {}
    
    pcall(function()
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.UseJumpPower = true
        end
    end)
    
    pcall(function()
        L.Brightness = 1
        L.ClockTime = 14
        L.Ambient = Color3.fromRGB(70, 70, 70)
        L.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        L.FogEnd = 100000
        L.GlobalShadows = true
    end)
    
    pcall(function() CM.FieldOfView = 70 end)
    
    pcall(function()
        if LP.Character then
            for _, p in ipairs(LP.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end)
    
    pcall(function()
        for _, data in pairs(espData or {}) do
            if data.hl then data.hl:Destroy() end
            if data.tag then data.tag:Destroy() end
        end
        espData = {}
    end)
    
    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    
    _G.MZ_HUB_RUNNING = false
    print("✅ MZ HUB: ปิดทุกฟังก์ชันเรียบร้อย")
end

